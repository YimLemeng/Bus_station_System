  </DataSources>
  <DataSets>
    <DataSet Name="RevenueDataSet">
      <Query>
        <DataSourceName>BusStationDBDataSet</DataSourceName>
        <CommandText>SELECT * FROM v_RevenueReport</CommandText>
      </Query>
      <Fields>
        <Field Name="RevenueDate">
          <DataField>RevenueDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Departure">
          <DataField>Departure</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Destination">
          <DataField>Destination</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PaymentMethod">
          <DataField>PaymentMethod</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
